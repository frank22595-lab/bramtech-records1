rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Student photos - readable by authenticated users, writable by admins
    match /students/{studentId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size < 500 * 1024 && // 500KB max after compression
        request.resource.contentType.matches('image/.*');
    }

    // School logo/branding - readable by all authenticated, writable by directors
    match /school/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size < 2 * 1024 * 1024 && // 2MB max
        request.resource.contentType.matches('image/.*');
    }
  }
}
